#!/usr/bin/env bash
# Example site env hook for a spack-built toolchain (see samples/README.md, prerequisites).
# Copy to samples/env.sh, or point SAMPLES_ENV at it; samples/common.sh sources it before it
# probes compilers. Adjust the specs to match what is installed -- no path is written by hand,
# every prefix comes from `spack location -i`.

# Order matters only for PATH precedence: gcc last, so gfortran/gcc are the plain-name compilers
# and the llvm/nvhpc ones are picked up under their own names (clang++, flang, nvfortran, nvcc).
spack load nvhpc
spack load openblas
spack load llvm@22.1.7
spack load gcc@16.1.0

# hdf5.mod is compiler-specific, so the baseline lanes need one HDF5 build per Fortran compiler.
# The gcc one is found through PATH (h5fc, h5cc); the other two are passed by prefix.
PATH="$(spack location -i hdf5+fortran%gcc@16.1.0)/bin:$PATH"
export PATH
HDF5_FLANG_ROOT="$(spack location -i hdf5+fortran%llvm@22.1.7)"
HDF5_NVFORTRAN_ROOT="$(spack location -i hdf5+fortran%nvhpc)"
export HDF5_FLANG_ROOT HDF5_NVFORTRAN_ROOT

# Optional overrides. PYTHON defaults to the pinned pyenv interpreter; CLANGXX/FLANG/NVFORTRAN
# and friends default to a PATH lookup and only need setting when the name is unusual.
# export PYTHON="$(spack location -i python@3.13)/bin/python3"
# export CLANGXX="$(spack location -i llvm@22.1.7)/bin/clang++"
