# Regenerable: `python generate_baselines.py` rebuilds baseline/ and codegen/ from the
# single-TU Fortran, so neither the SDFGs nor the DaCe-generated headers are tracked.
baseline/
codegen/
data_r02b05/
_dacegraphs/
__pycache__/
*.pyc
*.so
*.o

# Linked standalone drivers (3.9 MB each); rebuilt by utils.stages.stage<N> --compile.
velocity_stage*

# The root .gitignore excludes *.f90 because f2dace regenerates the velocity translation units.
# These two are not f2dace output: the bridge is hand-written and the mirror is generated by
# tools/gen_acc_mirror.py, which --check verifies against the tracked copy.
!src/velocity_acc_bridge.f90
!src/velocity_acc_mirror.f90
